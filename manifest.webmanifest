{
  "name": "尚贤圈",
  "short_name": "尚贤圈",
  "description": "校园半匿名信息交流社区：树洞、求助、二手、社团、学习、闲聊六大版块。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#f7f6f2",
  "theme_color": "#d6482f",
  "categories": ["social", "education"],
  "icons": [
    { "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "发布", "short_name": "发布", "url": "./index.html#/pages/publish/publish" },
    { "name": "私信", "short_name": "私信", "url": "./index.html#/pages/messages/messages" },
    { "name": "我的", "short_name": "我的", "url": "./index.html#/pages/mine/mine" }
  ],
  "id": "./",
  "prefer_related_applications": false,
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": { "client_mode": "focus-existing" },
  "edge_side_panel": { "preferred_width": 480 }
}
